<navigation-bar title="学院综合服务平台" back="{{false}}" background="#1a6eff" color="#ffffff"></navigation-bar>

<scroll-view class="home-page" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- 顶部欢迎区 -->
  <view class="welcome-section">
    <view class="welcome-bg"></view>
    <view class="welcome-content">
      <view class="welcome-text">
        <view class="greeting">你好，{{studentName}}</view>
        <view class="student-info">{{className}} · {{major}}</view>
      </view>
      <view class="avatar">{{avatarText}}</view>
    </view>

    <view class="quick-actions">
      <view class="action-item" bindtap="goToNotices">
        <view class="action-badge" wx:if="{{unreadNoticeCount > 0}}">{{unreadNoticeCount > 99 ? '99+' : unreadNoticeCount}}</view>
        <view class="action-icon">📬</view>
        <view class="action-label">最新通知</view>
      </view>
      <view class="action-item" bindtap="goToApplications">
        <view class="action-badge" wx:if="{{pendingCount > 0}}">{{pendingCount}}</view>
        <view class="action-icon">📋</view>
        <view class="action-label">我的申请</view>
      </view>
      <view class="action-item" bindtap="goToProcess">
        <view class="action-icon">🏛</view>
        <view class="action-label">党团进度</view>
      </view>
      <view class="action-item" bindtap="goToPolicySearch">
        <view class="action-icon">📖</view>
        <view class="action-label">政策查询</view>
      </view>
    </view>
  </view>

  <!-- 搜索入口 -->
  <view class="search-entry" bindtap="goToPolicySearch">
    <view class="search-bar-home">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索政策、流程、模板...</text>
    </view>
  </view>

  <!-- 常用服务 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">常用服务</view>
    </view>
    <view class="service-grid">
      <view class="service-item" bindtap="goToPolicySearch">
        <view class="service-icon s1">📋</view>
        <view class="service-name">政策搜索</view>
      </view>
      <view class="service-item" bindtap="goToProcess">
        <view class="service-icon s2">🏛</view>
        <view class="service-name">党团事务</view>
      </view>
      <view class="service-item" bindtap="goToCreateCertificate">
        <view class="service-icon s3">📝</view>
        <view class="service-name">证明申请</view>
      </view>
      <view class="service-item" bindtap="goToCreateLeave">
        <view class="service-icon s4">🏖</view>
        <view class="service-name">请假申请</view>
      </view>
      <view class="service-item" bindtap="goToTemplate">
        <view class="service-icon s5">📥</view>
        <view class="service-name">模板下载</view>
      </view>
    </view>
  </view>

  <!-- 党团流程卡片 -->
  <view class="section" wx:if="{{currentProcess}}">
    <view class="section-header">
      <view class="section-title">我的党团进度</view>
      <view class="section-more" bindtap="goToProcess">详情 ></view>
    </view>
    <view class="process-card card" bindtap="goToProcess">
      <view class="process-header">
        <view class="process-type">
          <status-tag type="primary">{{currentProcess.processLabel}}</status-tag>
        </view>
        <view class="process-stage-label">当前阶段</view>
      </view>
      <view class="process-current-stage">{{currentProcess.currentStage}}</view>
      <view class="process-bar">
        <view class="process-bar-fill" style="width: {{processPercent}}%"></view>
      </view>
      <view class="process-hint">点击查看详细进度和待办事项</view>
    </view>
  </view>

  <!-- 最新通知 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">最新通知</view>
      <view class="section-more" bindtap="goToNotices">全部 ></view>
    </view>
    <view wx:if="{{latestNotices.length > 0}}">
      <notice-card
        wx:for="{{latestNotices}}"
        wx:key="id"
        item="{{item}}"
        bindtap="goToNoticeDetail"
        data-id="{{item.id}}"
      />
    </view>
    <view class="empty-state" wx:else>
      <view class="icon">📭</view>
      <text>暂无新通知</text>
    </view>
  </view>

  <view class="safe-bottom" style="height: 40rpx;"></view>
</scroll-view>
