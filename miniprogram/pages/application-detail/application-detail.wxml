<navigation-bar title="申请详情" back="{{true}}" background="#ffffff" color="#333333"></navigation-bar>

<scroll-view class="detail-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="detail-container" wx:if="{{app}}">
    <view class="status-header-card">
      <status-tag type="{{statusType}}">{{app.statusLabel || app.status}}</status-tag>
      <view class="status-desc" wx:if="{{statusDesc}}">{{statusDesc}}</view>
    </view>

    <view class="info-card">
      <view class="info-title">申请信息</view>
      <view class="info-row"><text class="info-label">申请类型</text><text class="info-value">{{app.typeLabel || app.type}}</text></view>
      <view class="info-row"><text class="info-label">申请标题</text><text class="info-value">{{app.formData.title}}</text></view>
      <view class="info-row"><text class="info-label">提交时间</text><text class="info-value">{{app.createdAt}}</text></view>
      <view class="info-row" wx:if="{{app.updatedAt !== app.createdAt}}"><text class="info-label">最近更新</text><text class="info-value">{{app.updatedAt}}</text></view>
    </view>

    <view class="info-card" wx:if="{{app.formData}}">
      <view class="info-title">申请内容</view>
      <view class="content-text">{{app.formData.reason || '暂无详细说明'}}</view>
    </view>

    <view class="info-card" wx:if="{{app.attachments.length > 0}}">
      <view class="info-title">附件材料</view>
      <view class="attachment-item" wx:for="{{app.attachments}}" wx:key="*this" bindtap="downloadFile" data-file="{{item}}">
        <text class="attachment-icon">📎</text><text class="attachment-name">{{item}}</text>
      </view>
    </view>

    <view class="info-card" wx:if="{{approvalComment}}">
      <view class="info-title">审批意见</view>
      <view class="opinion-text">{{approvalComment}}</view>
    </view>

    <view class="info-card" wx:if="{{resultFilePath}}">
      <view class="info-title">结果文件</view>
      <view class="result-download" bindtap="downloadResult">
        <text class="download-icon">📥</text><text class="download-name">{{resultFileName}}</text><text class="download-btn">下载</text>
      </view>
    </view>

    <view class="action-area" wx:if="{{app.status === '待审批'}}">
      <button class="cancel-btn" bindtap="cancelApplication">撤销申请</button>
    </view>
  </view>

  <view class="empty-state" wx:else><text>申请不存在</text></view>
</scroll-view>
