<navigation-bar title="服务" back="{{false}}" background="#ffffff" color="#333333"></navigation-bar>

<scroll-view class="service-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="page-title">全部服务</view>

  <view class="service-list">
    <!-- 政策搜索 -->
    <view class="svc-card" bindtap="goToPolicySearch">
      <view class="svc-icon green">🔍</view>
      <view class="svc-info">
        <view class="svc-title">政策搜索</view>
        <view class="svc-desc">按关键词搜索政策、流程规定</view>
      </view>
      <view class="svc-arrow">></view>
    </view>

    <!-- 模板下载 -->
    <view class="svc-card" bindtap="goToTemplate">
      <view class="svc-icon orange">📥</view>
      <view class="svc-info">
        <view class="svc-title">模板下载</view>
        <view class="svc-desc">常用Word/Excel模板文件下载</view>
      </view>
      <view class="svc-arrow">></view>
    </view>

    <!-- 党团流程 -->
    <view class="svc-card" bindtap="goToProcess">
      <view class="svc-icon purple">🏛</view>
      <view class="svc-info">
        <view class="svc-title">党团流程</view>
        <view class="svc-desc">查看入党/入团流程与当前阶段</view>
      </view>
      <view class="svc-arrow">></view>
    </view>

    <!-- 证明申请 -->
    <view class="svc-card" bindtap="goToCreateCertificate">
      <view class="svc-icon red">📝</view>
      <view class="svc-info">
        <view class="svc-title">证明申请</view>
        <view class="svc-desc">在读证明、党团证明、盖章申请等</view>
      </view>
      <view class="svc-arrow">></view>
    </view>

    <!-- 请假申请 -->
    <view class="svc-card" bindtap="goToCreateLeave">
      <view class="svc-icon cyan">🏖</view>
      <view class="svc-info">
        <view class="svc-title">请假申请</view>
        <view class="svc-desc">在线提交请假申请，查看审批进度</view>
      </view>
      <view class="svc-arrow">></view>
    </view>

    <!-- 我的申请 -->
    <view class="svc-card" bindtap="goToApplications">
      <view class="svc-icon blue">📋</view>
      <view class="svc-info">
        <view class="svc-title">我的申请</view>
        <view class="svc-desc">查看所有申请记录和审批状态</view>
      </view>
      <view class="svc-arrow">></view>
    </view>
  </view>

  <view class="safe-bottom" style="height: 40rpx;"></view>
</scroll-view>
