<navigation-bar title="政策详情" back="{{true}}" background="#ffffff" color="#333333"></navigation-bar>

<scroll-view class="detail-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="detail-container" wx:if="{{item}}">
    <view class="detail-title">{{item.title}}</view>

    <view class="detail-meta">
      <view class="tag tag-blue">{{item.tags}}</view>
    </view>

    <view class="detail-content">
      <text>{{item.content}}</text>
    </view>

    <view class="disclaimer">
      <text>以上信息仅供参考，如有疑问请联系辅导员或相关负责老师。</text>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text>条目不存在或已删除</text>
  </view>
</scroll-view>
