<navigation-bar title="政策搜索" back="{{true}}" background="#ffffff" color="#333333"></navigation-bar>

<view class="knowledge-page">
  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索政策、流程..." value="{{keyword}}"
        bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
      <text class="search-btn" bindtap="onSearch">搜索</text>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{!isSearchMode}}">
    <view class="category-list">
      <view wx:for="{{tags}}" wx:key="*this"
        class="cat-item {{activeTag === item ? 'active' : ''}}"
        bindtap="onTagChange" data-tag="{{item}}">{{item}}</view>
    </view>
  </scroll-view>

  <!-- 结果列表 -->
  <scroll-view class="result-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="result-header" wx:if="{{isSearchMode}}">
      搜索"{{keyword}}"，找到 {{items.length}} 条结果
    </view>
    <view wx:if="{{items.length > 0}}">
      <view wx:for="{{items}}" wx:key="id" class="know-item"
        bindtap="goToDetail" data-id="{{item.id}}">
        <view class="know-title">📄 {{item.title}}</view>
        <view class="know-meta">
          <view class="tag tag-blue">{{item.tags}}</view>
        </view>
        <view class="know-desc">{{item.content}}</view>
      </view>
    </view>
    <view class="empty-state" wx:if="{{items.length === 0 && searched}}">
      <text>未找到相关内容</text>
    </view>
  </scroll-view>
</view>
