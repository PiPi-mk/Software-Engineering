<wxs src="../../utils/time.wxs" module="t" />

<navigation-bar title="通知中心" back="{{false}}" background="#ffffff" color="#333333"></navigation-bar>

<view class="notices-page">
  <scroll-view
    class="notice-list"
    scroll-y enhanced show-scrollbar="{{false}}"
    bindscrolltolower="onLoadMore"
  >
    <view wx:if="{{notices.length > 0}}">
      <view
        wx:for="{{notices}}"
        wx:key="id"
        class="notice-card {{item.read ? 'read' : ''}}"
        bindtap="goToDetail"
        data-id="{{item.id}}"
      >
        <view class="notice-title">
          <view class="unread-dot" wx:if="{{!item.read}}"></view>
          <text>{{item.title}}</text>
        </view>
        <view class="notice-time">{{t.formatTs(item.publishedAt)}}</view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{notices.length === 0 && !loading && !error}}">
      <view class="icon">📭</view>
      <text>暂无通知</text>
    </view>

    <view class="load-more" wx:if="{{loading}}"><text>加载中...</text></view>

    <view class="load-more error" wx:if="{{error}}" bindtap="loadNotices">
      <text>加载失败，点击重试</text>
    </view>

    <view class="load-more" wx:if="{{noMore && notices.length > 0}}">
      <text>没有更多了</text>
    </view>

    <view class="safe-bottom" style="height: 40rpx;"></view>
  </scroll-view>
</view>
